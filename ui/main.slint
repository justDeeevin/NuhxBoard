import { Spinner } from "std-widgets.slint";
export { ErrorPopup } from "error.slint";
export { SettingsPopup } from "settings.slint";

export global Loaded {
    in-out property <string> category;
    in-out property <[string]> layouts;
    in-out property <string> layout;
}

export component Main inherits Window {
    in property <bool> loading: true;
    in property <image> background-image;
    in property <brush> background-color <=> self.background;

    in-out property <string> t <=> self.title;
    in-out property <length> w <=> self.width;
    in-out property <length> h <=> self.height;

    callback open-settings;

    height: 300px;
    width: 300px;

    if loading: Spinner {
        indeterminate: true;
    }

    Image {
        source: background-image;
        width: w;
        height: h;
    }

    ContextMenuArea {
        Menu {
            MenuItem {
                title: "Settings";

                activated => open-settings();
            }

            MenuItem {
                title: "Load Keyboard";
            }

            MenuSeparator { }

            MenuItem {
                title: "Start Editing";
            }

            MenuSeparator { }

            Menu {
                title: "Save Definition";
            }

            Menu {
                title: "Save Style";
                MenuItem {
                    title: "Save To 'thing'";
                }

                MenuItem {
                    title: "Save As";
                }
            }
        }
    }
}
