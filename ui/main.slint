import { Spinner } from "std-widgets.slint";
import { Keyboard, Key, Speedometer } from "component/keyboard.slint";

export { Key, Speedometer } from "component/keyboard.slint";
export { ErrorPopup } from "error.slint";
export { SettingsPopup } from "settings.slint";
export { LoadKeyboard } from "load.slint";

export component Main inherits Window {
    in property <bool> loading: true;
    in property <image> background-image;
    in property <brush> background-color <=> self.background;
    in property <string> version;

    in-out property <string> t;
    in-out property <length> w <=> self.width;
    in-out property <length> h <=> self.height;

    in property <[Key]> keys <=> keyboard.keys;
    in property <[Speedometer]> speedometers <=> keyboard.speedometers;

    callback open-settings;
    callback open-load;

    height: 300px;
    width: 300px;
    title: t == "" ? "NuhxBoard v\{version}" : t;

    if loading: Spinner {
        indeterminate: true;
    }

    Image {
        source: background-image;
        width: w;
        height: h;
    }

    ContextMenuArea {
        Menu {
            MenuItem {
                title: "Settings";

                activated => open-settings();
            }

            MenuItem {
                title: "Load Keyboard";

                activated => open-load();
            }

            MenuSeparator { }

            MenuItem {
                title: "Start Editing";
            }

            MenuSeparator { }

            Menu {
                title: "Save Definition";
            }

            Menu {
                title: "Save Style";
                MenuItem {
                    title: "Save To 'thing'";
                }

                MenuItem {
                    title: "Save As";
                }
            }
        }
    }

    keyboard := Keyboard {
        width: 100%;
        height: 100%;
        x: 0;
        y: 0;
    }
}
