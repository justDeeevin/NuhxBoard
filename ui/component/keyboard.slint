export struct Key {
    id: int,
    button: bool,
    background: brush,
    background-image: image,
    bounding-box-pos: Point,
    bounding-box-size: Size,
    text: string,
    shift-text: string,
    change-on-caps: bool,
    styled-text: styled-text,
    styled-shift-text: styled-text,
    underline: bool,
    text-color: brush,
    text-position: Point,
    font-family: string,
    font-size: float,
    outline-color: brush,
    outline-width: length,
    commands: string,
}

export struct Speedometer {
    id: int,
    inner-color: brush,
    outer-color: brush,
    outline-width: length,
    position: Point,
    radius: length,
    x1: float,
    y1: float,
    x2: float,
    y2: float,
}

export component Keyboard {
    in property <[Key]> keys;
    in property <[Speedometer]> speedometers;
    in property <bool> shift;
    in property <bool> caps;
    in property <int> dx;
    in property <int> dy;
    in property <float> ball-to-ring-ratio;

    for key in keys: Rectangle {
        Path {
            viewbox-width: root.width / 1px;
            viewbox-height: root.height / 1px;
            fill: key.background-image.width == 0 && key.background-image.height == 0 ? key.background : transparent;
            stroke: key.outline-color;
            stroke-width: key.outline-width;
            commands: key.commands;
        }

        if key.background-image.width != 0 && key.background-image.height != 0: Image {
            source: key.background-image;
            x: key.bounding-box-pos.x;
            y: key.bounding-box-pos.y;
            width: key.bounding-box-size.width;
            height: key.bounding-box-size.height;
        }

        StyledText {
            default-color: key.text-color;
            default-font-family: key.font-family;
            default-font-size: key.font-size * 1pt;
            text: (!key.button && (shift != (caps && key.change-on-caps))) ? key.styled-shift-text : key.styled-text;
            x: key.text-position.x - (self.width / 2);
            y: key.text-position.y - (self.height / 2);
        }
    }

    for speedometer in speedometers: Rectangle {
        x: speedometer.position.x - (self.width / 2);
        y: speedometer.position.y - (self.height / 2);
        width: speedometer.radius * 2;
        height: self.width;
        border-radius: self.width / 2;
        border-width: speedometer.outline-width;
        border-color: speedometer.inner-color;

        Path {
            fill: white;
            viewbox-width: parent.width / 1px;
            viewbox-height: parent.height / 1px;

            MoveTo {
                x: parent.width / 2px;
                y: parent.height / 2px;
            }

            LineTo {
                x: speedometer.x1 + (parent.width / 2px);
                y: speedometer.y1 + (parent.height / 2px);
            }

            LineTo {
                x: speedometer.x2 + (parent.width / 2px);
                y: speedometer.y2 + (parent.height / 2px);
            }

            Close { }
        }

        Rectangle {
            width: speedometer.radius * 2 * ball-to-ring-ratio;
            height: self.width;
            border-radius: self.width / 2;
            background: speedometer.inner-color;
        }
    }
}
