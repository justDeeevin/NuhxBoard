export struct Key {
    id: int,
    background: brush,
    background-image: image,
    bounding-box-pos: Point,
    bounding-box-size: Size,
    text: string,
    styled-text: styled-text,
    underline: bool,
    text-color: brush,
    text-position: Point,
    font-family: string,
    font-size: float,
    outline-color: brush,
    outline-width: length,
    commands: string,
}

export struct Speedometer {
    position: Point,
    radius: length,
}

export component Keyboard {
    in property <[Key]> keys;
    in property <[Speedometer]> speedometers;

    for key in keys: Rectangle {
        Path {
            viewbox-width: root.width / 1px;
            viewbox-height: root.height / 1px;
            fill: key.background-image.width == 0 && key.background-image.height == 0 ? key.background : transparent;
            stroke: key.outline-color;
            stroke-width: key.outline-width;
            commands: key.commands;
        }

        if key.background-image.width != 0 && key.background-image.height != 0: Image {
            source: key.background-image;
            x: key.bounding-box-pos.x;
            y: key.bounding-box-pos.y;
            width: key.bounding-box-size.width;
            height: key.bounding-box-size.height;
        }

        StyledText {
            default-color: key.text-color;
            default-font-family: key.font-family;
            default-font-size: key.font-size * 1pt;
            text: key.styled-text;
            x: key.text-position.x - (self.width / 2);
            y: key.text-position.y - (self.height / 2);
        }
    }

    for speedometer in speedometers: Rectangle {
        x: speedometer.position.x - (self.width / 2);
        y: speedometer.position.y - (self.height / 2);
        width: speedometer.radius * 2;
        height: self.width;
        border-radius: self.width / 2;
        border-width: 2px;
        border-color: white;

        Rectangle {
            width: speedometer.radius * 2 * 0.2;
            height: self.width;
            border-radius: self.width / 2;
            background: white;
        }
    }
}
