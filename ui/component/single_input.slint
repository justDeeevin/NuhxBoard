import { ScrollView, Palette } from "std-widgets.slint";

export component SingleInput inherits Rectangle {
    in property <InputType> input-type <=> input.input-type;
    in-out property <string> text <=> input.text;

    min-width: 100px;
    height: 1.75rem;
    background: Palette.control-background;
    border-radius: 2px;

    ScrollView {
        VerticalLayout {
            padding-left: 3px;
            padding-right: self.padding-left;

            input := TextInput {
                color: Palette.control-foreground;
                vertical-alignment: center;

                @children
            }
        }
    }
}
