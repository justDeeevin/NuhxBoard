import { GroupBox, CheckBox, RadioGroup, Button } from "std-widgets.slint";
import { Labeled } from "component/labeled.slint";
import { SingleInput } from "component/single_input.slint";

export enum SCapitalization { lower, upper, follow }

export struct UserSettings {
    capitalization: SCapitalization,
    follow_for_caps_sensitive: bool,
    follow_for_caps_insensitive: bool,
    mouse_from_center: bool,
    mouse_sensitivity: string,
    min_press_time: string,
    scroll_hold_time: string,
    window_title: string,
}

export component SettingsPopup inherits Window {
    in-out property <UserSettings> settings;

    callback submit(UserSettings);

    title: "Settings";
    width: 650px;
    height: 400px;
    // default-font-size: 12px;

    VerticalLayout {
        padding-left: 5px;
        padding-bottom: self.padding-left;
        padding-right: self.padding-left;

        HorizontalLayout {
            alignment: start;
            GroupBox {
                title: "Input";

                VerticalLayout {
                    spacing: 3px;

                    Labeled {
                        label: "Mouse sensitivity";
                        input-type: decimal;
                        text <=> settings.mouse-sensitivity;
                        tooltip: @markdown("The sensitivity with which the mouse speed indicator reacts to mouse movement.");
                    }

                    Labeled {
                        label: "Scroll hold time";
                        input-type: number;
                        text <=> settings.scroll-hold-time;
                        tooltip: @markdown("The time (in milliseconds) before a mouse scroll is released.");
                    }

                    CheckBox {
                        text: "Calculate mouse speed from center of screen";
                        checked <=> settings.mouse-from-center;

                        Tooltip {
                            text: @markdown("Some games keep resetting the cursor position to the center of the screen. This setting uses this fact and compares the current mouse position to the center of the screen, rather than its last position.");
                        }
                    }

                    Text {
                        text: "Show keypresses for at least";
                    }

                    HorizontalLayout {
                        padding-left: 40px;
                        cross-axis-alignment: center;
                        spacing: 5px;

                        SingleInput {
                            input-type: number;
                            max-width: 50px;
                            min-width: 0;
                            text <=> settings.min-press-time;

                            Tooltip {
                                text: @markdown("The mimnimum number of milliseconds for which key and button presses will be highlighted. Presses any shorter will be highlighted precisely this long.");
                            }
                        }

                        Text {
                            text: "ms";
                        }
                    }
                }
            }

            GroupBox {
                title: "General";

                VerticalLayout {
                    alignment: start;

                    window-title-field := Labeled {
                        label: "Window title";
                        text <=> settings.window-title;
                        tooltip: @markdown("Fill in if you want a custom window title.\nIf left empty, the default window title of \"NuhxBoard {version}\" will be shown.");
                    }
                }
            }
        }

        GroupBox {
            title: "Capitalization of Keys";

            HorizontalLayout {
                alignment: space-evenly;

                RadioGroup {
                    follow := RadioButton {
                        text: "Follow Caps-Lock and Shift";
                        checked: settings.capitalization == SCapitalization.follow;

                        Tooltip {
                            text: @markdown("Show capitalized letter when shift or caps lock are active, but normal letters when both or neither are.");
                        }
                    }

                    upper := RadioButton {
                        text: "Show all buttons capitalized";
                        checked: settings.capitalization == SCapitalization.upper;

                        Tooltip {
                            text: @markdown("Always show capitalized letters.");
                        }
                    }

                    RadioButton {
                        text: "Show all buttons lower-case";
                        checked: settings.capitalization == SCapitalization.lower;

                        Tooltip {
                            text: @markdown("Always show lower-case letters.");
                        }
                    }
                }

                VerticalLayout {
                    alignment: start;

                    Text {
                        text: "Still follow shift for:";
                    }

                    CheckBox {
                        text: "Caps Lock insensitive keys";
                        enabled: !follow.checked;
                        checked <=> settings.follow-for-caps-insensitive;

                        if self.enabled: Tooltip {
                            text: @markdown("When Always show capitalized or lower-case letters is selected, checking this means the shift key is still used to shift to the alternate text on the element for all elements that are not sensitive to caps lock.");
                        }
                    }

                    CheckBox {
                        text: "Caps Lock sensitive keys";
                        enabled: !follow.checked;
                        checked <=> settings.follow-for-caps-sensitive;

                        if self.enabled: Tooltip {
                            text: @markdown("When Always show capitalized or lower-case letters is selected, checking this means the shift key is still used to shift to thhe alternate text on the element for all elements that are sensitive to caps lock.");
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            alignment: end;
            spacing: 10px;

            cancel := Button {
                text: "Cancel";
                clicked => root.close();
            }

            Button {
                width: cancel.min-width;
                text: "Ok";

                clicked => {
                    settings.capitalization = follow.checked ? SCapitalization.follow : (upper.checked ? SCapitalization.upper : lower);
                    submit(settings);
                    root.close();
                }
            }
        }
    }
}
