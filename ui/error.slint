import { ScrollView } from "std-widgets.slint";
export component ErrorPopup inherits Window {
    in property <string> message;

    width: 400px;
    height: 150px;

    ScrollView {
        VerticalLayout {
            Text {
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
                text: "Error: \{message}";
            }
        }
    }
}
